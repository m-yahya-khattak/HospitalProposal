# Local: copy to `.env.local`
# Vercel: Settings → Environment Variables → add both for Production, Preview, Development
# Redeploy after changing values (NEXT_PUBLIC_* is baked in at build time).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# After pulling this change, run supabase/migrations/004_project_guests.sql
# in the Supabase SQL editor so visitor logins can be created.
